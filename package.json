{
  "name": "life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "build": "tsc -b && vite build && node ./scripts/write-build-meta.mjs",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android && rm -rf android/app/src/main/assets/public/downloads",
    "android:open": "./scripts/run-with-local-jdk17.sh npx cap open android",
    "android:run": "npm run android:sync && ./scripts/run-with-local-jdk17.sh npx cap run android",
    "android:apk:debug": "npm run android:sync && ./scripts/android-gradlew.sh assembleDebug",
    "android:apk:release": "npm run android:sync && ./scripts/android-gradlew.sh assembleRelease",
    "android:bundle:release": "npm run android:sync && ./scripts/android-gradlew.sh bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^7.6.2",
    "@capacitor/core": "^8.3.1",
    "@capacitor/local-notifications": "^8.0.2",
    "@supabase/supabase-js": "^2.105.1",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^5.4.10",
    "vitest": "^4.1.9",
    "wrangler": "^3.114.17"
  }
}
